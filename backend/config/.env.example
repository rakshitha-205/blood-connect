# Copy this file to config/.env and fill in the values.
# Leave a section blank to keep testing mode (the code is shown on the verify page).
DB_URL=jdbc:postgresql://localhost:5432/blood_connect
DB_USERNAME=postgres
DB_PASSWORD=Postgresql@321
# ---- PostgreSQL ----
# The app uses the "bloodconnect" database; the tests use "bloodconnect_test".
# DB_URL=jdbc:postgresql://localhost:5432/blood_connect


# ---- Email OTP (SMTP) ----
# Gmail: turn on 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and paste the 16 characters (no spaces).
SMTP_HOST=smtp.gmail.com
# 465 uses SSL. For port 587 instead, also set SMTP_SSL=false.
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
# Optional; defaults to SMTP_USERNAME.
MAIL_FROM=
# Optional website address used for links in alert emails.
# APP_URL=http://localhost:5500

